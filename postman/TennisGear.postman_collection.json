          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"demo-training-racket\",\n  \"category\": \"rackets\",\n  \"brand\": \"Demo\",\n  \"name\": \"Training 100\",\n  \"subtitle\": \"LEARNING / DEMO\",\n  \"description\": \"An educational product added through the custom API.\",\n  \"highlights\": [\n    \"Demonstration product\"\n  ],\n  \"specifications\": {\n    \"Head size\": \"100 in\\u00b2\"\n  },\n  \"accent\": \"#b6e562\",\n  \"tone\": \"mint\",\n  \"featured\": false,\n  \"is_new\": true\n}"
