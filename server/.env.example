PORT=4000
# Supabase PostgreSQL is REQUIRED in development and production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: if set, required for POST/PUT/DELETE operations.
ADMIN_KEY=
# Comma-separated frontend origins. Production uses the actual frontend Vercel URL.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4180
