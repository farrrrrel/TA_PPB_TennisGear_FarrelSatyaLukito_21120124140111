PORT=4000
# Local demo mode runs without Supabase, using server/data/products.json
# For hosted production, fill BOTH with your Supabase project credentials:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Protect POST, PUT and DELETE endpoints with your own long random key:
ADMIN_KEY=
# Set to your Vercel frontend URL in production (comma-separated for multiple):
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
